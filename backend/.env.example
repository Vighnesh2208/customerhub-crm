# =============================================================================
# CustomerHub CRM - Backend Environment Configuration
# =============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# If the WooCommerce credentials below are left empty, the application runs in
# DEMO MODE using rich sample customer and order data.
# =============================================================================

# Server Port (default: 3000)
PORT=3000

# CORS Allowed Origin (defaults to http://localhost:5175 if omitted)
FRONTEND_URL=http://localhost:5175

# WooCommerce Store REST API v3 Credentials
# -----------------------------------------------------------------------------
# 1. Store URL: The base URL of your WooCommerce/WordPress installation.
#    Example: https://mystore.example.com
WOOCOMMERCE_STORE_URL=

# 2. Consumer Key: Generated in WooCommerce > Settings > Advanced > REST API
#    Example: ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_KEY=

# 3. Consumer Secret: Keep this secret! Never expose it to the client.
#    Example: cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=

# 4. Optional: API Request Timeout in milliseconds (default: 10000ms / 10s)
WOOCOMMERCE_TIMEOUT_MS=10000
